# Database
DATABASE_URL=postgresql://user:password@localhost:5432/art_marketplace

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudinary (Image Upload) - Using Unsigned Uploads
# Sign up free at https://cloudinary.com/console
# Create an unsigned upload preset in Settings > Upload > Upload presets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_preset_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your_api_key

# Resend (Email)
RESEND_API_KEY=re_...
# Verified sending address. The default onboarding@resend.dev ONLY delivers to
# the Resend account owner. Verify a domain at resend.com/domains for real sending.
EMAIL_FROM=Goodness Gracious Gabriel <orders@yourdomain.com>

# Twilio (SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1234567890

# Admin Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com

# Local pickup. Sales tax on a pickup order is sourced to the studio, not the
# buyer, so set this to the studio's real ZIP. Washington rates vary by city.
PICKUP_POSTAL_CODE=98101

# USPS address verification (free). Create a USPS Business Account at
# https://developers.usps.com/, register an app, and copy its credentials here.
# Addresses is part of the free default product. Without these the app falls
# back to an OpenStreetMap lookup, which confirms a place exists but cannot
# confirm USPS actually delivers there.
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=
